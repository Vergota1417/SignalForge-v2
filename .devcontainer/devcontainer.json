{
  "name": "SignalForge Agent Sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "node",
  "containerEnv": {
    "SIGNALFORGE_SANDBOX": "1",
    "WRANGLER_SEND_METRICS": "false",
    "NODE_ENV": "development"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "SignalForge local Worker",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install && npm run test:manifest && npm run check:syntax",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
