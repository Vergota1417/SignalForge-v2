{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "signalforge-v2",
  "main": "src/index.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "secrets": {
    "required": ["TWELVE_DATA_API_KEY", "VAPID_PRIVATE_KEY"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * 1-5"]
  },
  "vars": {
    "WATCHLIST": "XOM,NVDA,MSFT,AAPL,AMZN,TSLA",
    "MAX_PROVIDER_REQUESTS_PER_DAY": "700",
    "ALERT_STATUSES": "BUY NOW|SETUP — READY SOON|WAIT FOR PULLBACK|SELL / EXIT",
    "PUSH_ALERT_STATUSES": "SETUP — READY SOON|BUY NOW|SELL / EXIT",
    "VAPID_SUBJECT": "https://signalforge-v2.mj23mgomez3.workers.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
